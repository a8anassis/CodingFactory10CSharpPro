@page
@model WebAppStarter10.Pages.Students.ViewStudentsModel
@{
    ViewData["Title"] = "View Students"
}

<div class="container">

    <h1>Students List</h1>

    <form method="get">
        <div class="input-group w-50">
            <input type="text" name="lastname" class="form-control" placeholder="Enter lastname" />
            <button type="submit" class="btn btn-primary"></button>
        </div>
    </form>

    @if (Model.StudentsReadOnlyDTOs.Any())
    {
        <table class="table table-dark text-center w-75">
            <thead>
                <tr class="table-primary"><th span="3">Coding Factory Students</th></tr>
                <tr>
                    <th>Id</th>
                    <th>Firstname</th>
                    <th>Lastname</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var studentReadOnlyDTO in Model.StudentsReadOnlyDTOs)
                {
                    <tr>
                        <th>@studentReadOnlyDTO.Id</th>
                        <th>@studentReadOnlyDTO.Firstname</th>
                        <th>@studentReadOnlyDTO.Lastname</th>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No Students found.</p>
    }




</div>
